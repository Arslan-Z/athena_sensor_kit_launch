<launch>
  <arg name="launch_driver" default="true"/>
  <arg name="camera_namespace" default="/sensing/camera"/>
  <arg name="camera_name" default="d455"/>
  <arg name="camera_id" default="0"/>

  <group if="$(var launch_driver)">
    <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
      <arg name="camera_namespace" value="$(var camera_namespace)"/>
      <arg name="camera_name" value="$(var camera_name)"/>
    </include>
  </group>

  <group>
    <push-ros-namespace namespace="$(var camera_namespace)"/>
    <group>
      <push-ros-namespace namespace="$(var camera_name)"/>
      <node pkg="topic_tools" exec="relay" name="d455_camera_info_relay" output="log">
        <param name="input_topic" value="color/camera_info"/>
        <param name="output_topic" value="/sensing/camera/camera$(var camera_id)/camera_info"/>
        <param name="type" value="sensor_msgs/msg/CameraInfo"/>
        <param name="reliability" value="best_effort"/>
      </node>

      <node pkg="topic_tools" exec="relay" name="d455_camera_image_relay" output="log">
        <param name="input_topic" value="color/image_raw"/>
        <param name="output_topic" value="/sensing/camera/camera$(var camera_id)/image_raw"/>
        <param name="type" value="sensor_msgs/msg/Image"/>
        <param name="reliability" value="best_effort"/>
      </node>

      <node pkg="topic_tools" exec="relay" name="d455_compressed_image_relay" output="log">
        <param name="input_topic" value="color/image_raw/compressed"/>
        <param name="output_topic" value="/sensing/camera/camera$(var camera_id)/image_raw/compressed"/>
        <param name="type" value="sensor_msgs/msg/CompressedImage"/>
        <param name="reliability" value="best_effort"/>
      </node>
    </group>
  </group>

</launch>
