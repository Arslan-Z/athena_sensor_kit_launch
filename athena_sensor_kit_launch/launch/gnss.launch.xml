<launch>
  <arg name="launch_driver" default="true"/>
  <!-- <arg name="gnss_receiver" default="ublox" description="ublox(default) or septentrio"/> -->
  <arg name="gnss_receiver" default="fixposition" description="fixposition(default) or septentrio"/>

  <group>
    <push-ros-namespace namespace="gnss"/>

    <!-- Switch topic name -->
    <!-- <let name="navsatfix_topic_name" value="ublox/nav_sat_fix" if="$(eval &quot;'$(var gnss_receiver)'=='ublox'&quot;)"/>
    <let name="navsatfix_topic_name" value="septentrio/nav_sat_fix" if="$(eval &quot;'$(var gnss_receiver)'=='septentrio'&quot;)"/>
    <let name="orientation_topic_name" value="/autoware_orientation"/> -->
    <let name="navsatfix_topic_name" value="ublox/nav_sat_fix" if="$(eval &quot;'$(var gnss_receiver)'=='ublox'&quot;)"/>
    <let name="navsatfix_topic_name" value="septentrio/nav_sat_fix" if="$(eval &quot;'$(var gnss_receiver)'=='septentrio'&quot;)"/>
    <let name="navsatfix_topic_name" value="fixposition/odometry_llh" if="$(eval &quot;'$(var gnss_receiver)'=='fixposition'&quot;)"/>
    <let name="orientation_topic_name" value="/autoware_orientation"/>

    <!-- FixPosition GNSS Driver -->
    <group if="$(eval &quot;'$(var launch_driver)' and '$(var gnss_receiver)'=='fixposition'&quot;)">
      <node name="fixposition_driver_ros2" pkg="fixposition_driver_ros2" exec="fixposition_driver_ros2_exec" output="screen" respawn="true" respawn_delay="5">
        <param from="$(find-pkg-share athena_sensor_kit_launch)/data/gnss/vrtk_2.yaml" />
      </node>
      <!-- <node name="fixposition_driver_ros2" pkg="fixposition_driver_ros2" exec="fixposition_driver_ros2_exec" output="screen" respawn="true" respawn_delay="5">
        <param from="$(find-pkg-share fixposition_driver_ros2)/launch/donner_tcp.yaml" />
      </node> -->
      <!-- <include file="$(find-pkg-share fixposition_driver_ros2)/launch/donner_tcp.launch">
      </include> -->
    </group>

    <!-- Ublox Driver -->
    <group if="$(eval &quot;'$(var gnss_receiver)'=='ublox'&quot;)">
      <node pkg="ublox_gps" name="ublox" exec="ublox_gps_node" if="$(var launch_driver)" respawn="true" respawn_delay="1.0">
        <remap from="~/fix" to="~/nav_sat_fix"/>
        <param from="$(find-pkg-share ublox_gps)/c94_f9p_rover.yaml"/>
      </node>
    </group>

    <!-- Septentrio GNSS Driver -->
    <group if="$(eval &quot;'$(var launch_driver)' and '$(var gnss_receiver)'=='septentrio'&quot;)">
      <include file="$(find-pkg-share septentrio_gnss_driver)/launch/mosaic_x5_rover.launch.xml"/>
    </group>

    <!-- NavSatFix to MGRS Pose -->
    <include file="$(find-pkg-share gnss_poser)/launch/gnss_poser.launch.xml">
      <arg name="param_file" value="$(find-pkg-share donner_sensor_kit_launch)/config/gnss/gnss_poser.param.yaml"/>
      <arg name="input_topic_fix" value="$(var navsatfix_topic_name)"/>
      <arg name="input_topic_orientation" value="$(var orientation_topic_name)"/>

      <arg name="output_topic_gnss_pose" value="pose"/>
      <arg name="output_topic_gnss_pose_cov" value="pose_with_covariance"/>
      <arg name="output_topic_gnss_fixed" value="fixed"/>

      <arg name="use_gnss_ins_orientation" value="false"/>
    </include>

    <!-- Add Static TF Transform -->
    <node pkg="tf2_ros" exec="static_transform_publisher" name="static_tf_FP_POI" args="0 0 0 0 0 0 FP_POI_link FP_POI" output="screen">
      <!-- Optional: Set additional parameters or remappings if needed -->
    </node>

    <!-- <node pkg="tf2_ros" exec="static_transform_publisher" output="screen" args="0.5 0 0 0 0 0 base_link tamagawa/imu_link"/> -->


  </group>
</launch>
